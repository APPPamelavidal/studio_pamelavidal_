<style>
/* ===== CURSO PAGE ===== */
.curso-hero {
  background: linear-gradient(160deg, #2d1f27 0%, #4a2d3a 60%, #6b3d52 100%);
  padding: 52px 24px 44px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.curso-hero::before {
  content:'';
  position:absolute; top:-80px; right:-80px;
  width:300px; height:300px; border-radius:50%;
  background:radial-gradient(circle,rgba(201,168,76,.18),transparent 70%);
  pointer-events:none;
}
.curso-hero::after {
  content:'';
  position:absolute; bottom:-60px; left:-60px;
  width:240px; height:240px; border-radius:50%;
  background:radial-gradient(circle,rgba(212,121,154,.15),transparent 70%);
  pointer-events:none;
}
.curso-tag {
  display:inline-block;
  background:var(--ouro); color:#fff;
  font-size:.78rem; font-weight:700; letter-spacing:.06em;
  padding:5px 16px; border-radius:50px; margin-bottom:18px;
  text-transform:uppercase;
}
.curso-hero h1 {
  font-size:2.3rem; color:#fff; line-height:1.2; margin-bottom:14px;
}
.curso-hero h1 span { color:var(--ouro); }
.curso-hero p {
  color:rgba(255,255,255,.75); max-width:460px;
  margin:0 auto 32px; line-height:1.7; font-size:.97rem;
}

/* Badges */
.curso-badges {
  display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-bottom:32px;
}
.curso-badge-item {
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);
  color:rgba(255,255,255,.9);
  padding:7px 16px; border-radius:50px;
  font-size:.83rem; font-weight:500;
}

/* CTA principal */
.btn-whats-curso {
  display:inline-flex; align-items:center; gap:12px;
  background:linear-gradient(135deg,#25d366,#128c7e);
  color:#fff; padding:16px 36px; border-radius:50px;
  font-size:1.05rem; font-weight:700; text-decoration:none;
  box-shadow:0 6px 24px rgba(37,211,102,.4);
  transition:all .25s ease;
}
.btn-whats-curso:hover { transform:translateY(-3px); box-shadow:0 10px 30px rgba(37,211,102,.5); color:#fff; }
.btn-whats-curso svg { width:24px; height:24px; fill:#fff; flex-shrink:0; }

/* ===== VÍDEO ===== */
.video-section {
  background:#fff;
  padding:44px 20px;
  text-align:center;
  border-bottom:1px solid var(--cinza-b);
}
.video-section h2 {
  font-size:1.6rem; color:var(--escuro); margin-bottom:10px;
}
.video-section p { color:var(--cinza-txt); margin-bottom:28px; font-size:.93rem; }

.video-placeholder {
  max-width:600px; margin:0 auto;
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:var(--sombra-lg);
  position:relative;
  background: linear-gradient(135deg, #2d1f27, #4a2d3a);
  aspect-ratio:16/9;
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  gap:16px; cursor:pointer;
}
.video-placeholder .play-btn {
  width:72px; height:72px; border-radius:50%;
  background:rgba(255,255,255,.15);
  border:3px solid rgba(255,255,255,.5);
  display:flex; align-items:center; justify-content:center;
  transition:all .25s;
}
.video-placeholder:hover .play-btn {
  background:rgba(255,255,255,.25);
  border-color:#fff;
  transform:scale(1.08);
}
.play-btn svg { width:28px; height:28px; fill:#fff; margin-left:4px; }
.video-placeholder .vp-text { color:rgba(255,255,255,.8); font-size:.9rem; }
.video-placeholder .vp-sub  { color:rgba(255,255,255,.45); font-size:.78rem; }

/* Quando tiver URL do YouTube */
.video-frame {
  max-width:600px; margin:0 auto;
  border-radius:var(--radius); overflow:hidden;
  box-shadow:var(--sombra-lg); aspect-ratio:16/9;
  display:none;
}
.video-frame iframe { width:100%; height:100%; border:none; display:block; }

/* ===== O QUE VOCÊ VAI APRENDER ===== */
.topics-section {
  background:var(--cinza-f);
  padding:44px 20px;
}
.topics-section h2 {
  text-align:center; font-size:1.5rem; color:var(--escuro); margin-bottom:28px;
}
.topics-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:14px; max-width:700px; margin:0 auto;
}
.topic-card {
  background:#fff; border-radius:var(--radius);
  padding:20px 18px; box-shadow:var(--sombra);
  display:flex; align-items:flex-start; gap:12px;
  border-left:4px solid var(--rosa);
}
.topic-card .tc-icon { font-size:1.5rem; flex-shrink:0; margin-top:2px; }
.topic-card h4 { font-size:.95rem; color:var(--escuro); margin-bottom:3px; }
.topic-card p  { font-size:.82rem; color:var(--cinza-txt); line-height:1.5; }

/* ===== DEPOIMENTOS (placeholder) ===== */
.depo-section {
  background:#fff; padding:44px 20px; text-align:center;
  border-top:1px solid var(--cinza-b);
}
.depo-section h2 { font-size:1.5rem; color:var(--escuro); margin-bottom:24px; }
.depo-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:16px; max-width:700px; margin:0 auto 32px;
}
.depo-card {
  background:var(--cinza-f); border-radius:var(--radius);
  padding:20px; text-align:left;
  border:1.5px solid var(--cinza-b);
}
.depo-card .estrelas { color:var(--ouro); font-size:1rem; margin-bottom:8px; }
.depo-card p { font-size:.88rem; color:var(--cinza-txt); line-height:1.6; margin-bottom:12px; }
.depo-card .depo-nome { font-weight:700; font-size:.85rem; color:var(--escuro); }

/* ===== CTA FINAL ===== */
.cta-section {
  background:linear-gradient(135deg,#2d1f27,#4a2d3a);
  padding:52px 24px; text-align:center;
}
.cta-section h2 { color:#fff; font-size:1.8rem; margin-bottom:12px; }
.cta-section p  { color:rgba(255,255,255,.75); margin-bottom:28px; font-size:.95rem; }

@media(max-width:480px){
  .curso-hero h1 { font-size:1.75rem; }
}
</style>
