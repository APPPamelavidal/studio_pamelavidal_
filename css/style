@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap');

/* =====================
   VARIÁVEIS
===================== */
:root {
  --rosa:        #c96b8a;
  --rosa-esc:    #a84e6e;
  --rosa-light:  #f7e0e9;
  --rosa-pale:   #fdf4f7;
  --ouro:        #c4973e;
  --ouro-light:  #f5e9d3;
  --escuro:      #1a1018;
  --escuro-2:    #2e1e28;
  --cinza:       #6b5a63;
  --cinza-light: #f0e8ec;
  --branco:      #ffffff;
  --sombra:      0 4px 30px rgba(180,90,120,.10);
  --sombra-lg:   0 12px 50px rgba(180,90,120,.18);
  --radius:      20px;
  --radius-sm:   12px;
  --radius-xs:   8px;
  --trans:       .3s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; -webkit-font-smoothing:antialiased; }
body { font-family:'DM Sans',sans-serif; background:var(--rosa-pale); color:var(--escuro); min-height:100vh; }
h1,h2,h3,h4,h5 { font-family:'Cormorant Garamond',serif; }
a { color:var(--rosa); text-decoration:none; transition:color var(--trans); }

/* =====================
   TOAST
===================== */
#toast-container { position:fixed; top:20px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:10px; }
.toast {
  background:var(--escuro); color:#fff;
  padding:14px 20px; border-radius:var(--radius-sm);
  font-size:.88rem; box-shadow:var(--sombra-lg);
  animation:toastIn .3s ease forwards;
  max-width:300px; line-height:1.4;
}
.toast.ok   { border-left:4px solid #66bb6a; }
.toast.err  { border-left:4px solid #ef5350; }
.toast.info { border-left:4px solid var(--ouro); }
@keyframes toastIn { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }

/* =====================
   HEADER
===================== */
.site-header {
  position:sticky; top:0; z-index:100;
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(201,107,138,.1);
  padding:0 24px;
  height:64px;
  display:flex; align-items:center; justify-content:space-between;
}
.header-logo {
  font-family:'Cormorant Garamond',serif;
  font-size:1.4rem; font-weight:700;
  color:var(--escuro); letter-spacing:.02em;
}
.header-logo span { color:var(--rosa); }
.header-nav { display:flex; align-items:center; gap:8px; }
.header-nav a {
  font-size:.85rem; font-weight:500; color:var(--cinza);
  padding:8px 16px; border-radius:50px;
  transition:all var(--trans);
}
.header-nav a:hover { color:var(--rosa); background:var(--rosa-light); }
.header-nav .nav-cta {
  background:var(--rosa); color:#fff !important;
  box-shadow:0 4px 14px rgba(201,107,138,.35);
}
.header-nav .nav-cta:hover { background:var(--rosa-esc); transform:translateY(-1px); }

/* =====================
   BOTÃO VOLTAR
===================== */
.btn-voltar {
  display:inline-flex; align-items:center; gap:6px;
  padding:9px 18px; border-radius:50px;
  background:var(--branco); color:var(--cinza);
  border:1.5px solid var(--cinza-light);
  font-size:.85rem; font-weight:500; cursor:pointer;
  transition:all var(--trans); margin-bottom:24px;
  text-decoration:none;
}
.btn-voltar:hover { border-color:var(--rosa); color:var(--rosa); }
.btn-voltar svg { width:15px; height:15px; }

/* =====================
   BOTÕES
===================== */
.btn {
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:13px 28px; border-radius:50px;
  font-family:'DM Sans',sans-serif; font-weight:600; font-size:.95rem;
  cursor:pointer; border:none; text-decoration:none;
  transition:all var(--trans); position:relative; overflow:hidden;
}
.btn::after {
  content:''; position:absolute; inset:0;
  background:rgba(255,255,255,0);
  transition:background var(--trans);
}
.btn:hover::after { background:rgba(255,255,255,.12); }

.btn-primary {
  background:linear-gradient(135deg, var(--rosa), var(--rosa-esc));
  color:#fff; box-shadow:0 6px 20px rgba(201,107,138,.4);
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(201,107,138,.5); color:#fff; }

.btn-gold {
  background:linear-gradient(135deg, var(--ouro), #a87830);
  color:#fff; box-shadow:0 6px 20px rgba(196,151,62,.35);
}
.btn-gold:hover { transform:translateY(-2px); color:#fff; }

.btn-outline {
  background:transparent; color:var(--rosa);
  border:2px solid var(--rosa);
}
.btn-outline:hover { background:var(--rosa); color:#fff; transform:translateY(-1px); }

.btn-dark {
  background:var(--escuro); color:#fff;
  box-shadow:0 6px 20px rgba(26,16,24,.3);
}
.btn-dark:hover { background:var(--escuro-2); transform:translateY(-2px); color:#fff; }

.btn-danger { background:linear-gradient(135deg,#ef5350,#c62828); color:#fff; }
.btn-danger:hover { transform:translateY(-1px); color:#fff; }

.btn-success { background:linear-gradient(135deg,#66bb6a,#388e3c); color:#fff; }
.btn-whats {
  background:linear-gradient(135deg,#25d366,#128c7e);
  color:#fff; box-shadow:0 6px 20px rgba(37,211,102,.35);
}
.btn-whats:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(37,211,102,.45); color:#fff; }

.btn-insta {
  background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);
  color:#fff; box-shadow:0 6px 20px rgba(220,39,67,.3);
}
.btn-insta:hover { transform:translateY(-2px); color:#fff; }

.btn-sm { padding:8px 18px; font-size:.83rem; }
.btn-lg { padding:16px 36px; font-size:1.05rem; }
.btn-full { width:100%; }

/* =====================
   FORMS
===================== */
.field { margin-bottom:16px; }
.field label {
  display:block; font-size:.8rem; font-weight:600;
  color:var(--cinza); margin-bottom:6px;
  text-transform:uppercase; letter-spacing:.05em;
}
.field input,
.field select,
.field textarea {
  width:100%; padding:14px 18px;
  border:1.5px solid var(--cinza-light);
  border-radius:var(--radius-sm);
  font-size:.95rem; font-family:'DM Sans',sans-serif;
  background:var(--branco); color:var(--escuro);
  transition:all var(--trans);
}
.field input:focus,
.field select:focus,
.field textarea:focus {
  outline:none; border-color:var(--rosa);
  box-shadow:0 0 0 4px rgba(201,107,138,.12);
}
.field textarea { resize:vertical; min-height:90px; }
.field-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }

/* =====================
   CARD / CONTAINER
===================== */
.card {
  background:var(--branco);
  border-radius:var(--radius);
  box-shadow:var(--sombra);
  overflow:hidden;
}
.card-pad { padding:28px; }

.container {
  max-width:480px; margin:40px auto;
  padding:0 18px;
}
.container-wide {
  max-width:800px; margin:0 auto; padding:28px 18px;
}

/* =====================
   SEÇÃO TÍTULOS
===================== */
.section-tag {
  display:inline-block;
  background:var(--rosa-light); color:var(--rosa-esc);
  font-size:.75rem; font-weight:700; letter-spacing:.08em;
  text-transform:uppercase; padding:5px 14px; border-radius:50px;
  margin-bottom:12px;
}
.section-title {
  font-size:2rem; color:var(--escuro); line-height:1.2; margin-bottom:10px;
}
.section-title span { color:var(--rosa); font-style:italic; }
.section-sub { color:var(--cinza); font-size:.93rem; line-height:1.65; }

/* =====================
   PAGE TITLE (auth pages)
===================== */
.page-title { font-size:2rem; color:var(--escuro); margin-bottom:6px; text-align:center; }
.page-subtitle { color:var(--cinza); font-size:.9rem; text-align:center; margin-bottom:28px; }
.form-link { text-align:center; margin-top:20px; font-size:.88rem; color:var(--cinza); }

/* =====================
   DIVIDER
===================== */
.divider { border:none; border-top:1px solid var(--cinza-light); margin:24px 0; }

/* =====================
   ADMIN TABS
===================== */
.admin-tabs {
  display:flex; gap:4px; background:var(--cinza-light);
  padding:5px; border-radius:50px; margin-bottom:24px; flex-wrap:wrap;
}
.admin-tab {
  flex:1; padding:10px 16px; border:none; border-radius:50px;
  background:transparent; font-family:'DM Sans',sans-serif;
  font-size:.83rem; font-weight:600; color:var(--cinza);
  cursor:pointer; transition:all var(--trans); white-space:nowrap; text-align:center;
}
.admin-tab.ativo { background:var(--branco); color:var(--rosa-esc); box-shadow:var(--sombra); }
.tab-panel { display:none; }
.tab-panel.ativo { display:block; }

/* =====================
   ADMIN SECTION
===================== */
.admin-section {
  background:var(--branco); border-radius:var(--radius);
  padding:24px; margin-bottom:18px; box-shadow:var(--sombra);
}
.admin-section-title {
  font-family:'Cormorant Garamond',serif;
  font-size:1.2rem; color:var(--rosa-esc); margin-bottom:16px;
  display:flex; align-items:center; gap:8px;
}

/* =====================
   HORÁRIOS
===================== */
.horario-item {
  display:flex; justify-content:space-between; align-items:center;
  padding:14px 16px; border-radius:var(--radius-sm);
  background:var(--rosa-pale); border:1.5px solid var(--cinza-light);
  margin-bottom:10px; gap:10px; flex-wrap:wrap;
}
.hi-info { font-weight:600; font-size:.92rem; }
.hi-status {
  font-size:.75rem; font-weight:700; padding:4px 12px;
  border-radius:50px; text-transform:uppercase; letter-spacing:.04em;
}
.hi-status.livre { background:#e8f5e9; color:#2e7d32; }
.hi-status.agend { background:#fce4ec; color:#c62828; }

/* =====================
   CHIPS DE DATA
===================== */
.datas-chips { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
.data-chip {
  padding:8px 18px; border-radius:50px;
  border:1.5px solid var(--cinza-light); background:var(--branco);
  font-size:.85rem; font-weight:600; cursor:pointer; transition:all var(--trans);
}
.data-chip:hover { border-color:var(--rosa); color:var(--rosa); }
.data-chip.ativo { border-color:var(--rosa); background:var(--rosa-light); color:var(--rosa-esc); }

/* =====================
   HORÁRIO CARD (cliente)
===================== */
.horario-card {
  background:var(--branco); border:1.5px solid var(--cinza-light);
  border-radius:var(--radius-sm); padding:16px 20px; margin-bottom:10px;
  display:flex; justify-content:space-between; align-items:center;
  box-shadow:var(--sombra); transition:border-color var(--trans);
}
.horario-card:hover { border-color:var(--rosa); }
.hc-data { font-weight:700; font-size:.97rem; }
.hc-hora { font-size:.83rem; color:var(--cinza); margin-top:2px; }

/* =====================
   OPÇÕES (café/brindes)
===================== */
.opcoes-grid {
  display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr));
  gap:10px; margin-bottom:18px;
}
.opcao-item {
  border:2px solid var(--cinza-light); border-radius:var(--radius-sm);
  padding:14px 10px; text-align:center; cursor:pointer;
  transition:all var(--trans); background:var(--branco);
  font-size:.85rem; font-weight:500; user-select:none;
}
.opcao-item:hover { border-color:var(--rosa); background:var(--rosa-light); }
.opcao-item.selecionado {
  border-color:var(--rosa); background:var(--rosa-light);
  color:var(--rosa-esc); font-weight:700;
  box-shadow:0 4px 14px rgba(201,107,138,.2);
}
.oi-emoji { font-size:1.6rem; display:block; margin-bottom:6px; }

/* =====================
   AGEND CARD
===================== */
.agend-card {
  background:var(--branco); border:1.5px solid var(--cinza-light);
  border-radius:var(--radius); padding:20px 22px;
  margin-bottom:14px; box-shadow:var(--sombra);
  transition:all var(--trans);
}
.agend-card:hover { border-color:rgba(201,107,138,.3); }
.agend-card h4 { color:var(--rosa-esc); margin-bottom:8px; font-size:1.05rem; }
.agend-card p { font-size:.88rem; color:var(--cinza); margin-bottom:4px; line-height:1.5; }
.ac-tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
.ac-tag {
  background:var(--rosa-pale); border:1px solid var(--cinza-light);
  padding:4px 12px; border-radius:50px; font-size:.76rem; color:var(--cinza);
}

/* =====================
   BANNER CARDS
===================== */
.banner-card { border-radius:var(--radius); overflow:hidden; box-shadow:var(--sombra); position:relative; }
.banner-card img { width:100%; height:180px; object-fit:cover; display:block; }
.banner-label {
  position:absolute; bottom:0; left:0; right:0;
  background:linear-gradient(0deg,rgba(26,16,24,.8),transparent);
  color:#fff; padding:24px 16px 14px;
  font-size:.88rem; font-weight:600;
}

/* =====================
   BANNER ADMIN
===================== */
.banner-preview-lista {
  display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
  gap:12px; margin-top:16px;
}
.banner-preview-item { position:relative; border-radius:var(--radius-sm); overflow:hidden; box-shadow:var(--sombra); }
.banner-preview-item img { width:100%; height:100px; object-fit:cover; display:block; }
.banner-preview-item input {
  width:100%; padding:6px 10px; font-size:.78rem;
  border:none; border-top:1px solid var(--cinza-light); background:var(--rosa-pale);
}
.rem-banner {
  position:absolute; top:6px; right:6px;
  background:rgba(239,83,80,.9); color:#fff; border:none; border-radius:50%;
  width:24px; height:24px; cursor:pointer; font-size:.75rem;
  display:flex; align-items:center; justify-content:center;
}

/* =====================
   OPÇÃO ADMIN
===================== */
.opcao-admin-item {
  display:flex; align-items:center; gap:10px;
  padding:10px 0; border-bottom:1px solid var(--cinza-light);
}
.opcao-admin-item:last-child { border-bottom:none; }
.opcao-admin-item input[type="text"] {
  padding:9px 14px; border:1.5px solid var(--cinza-light);
  border-radius:var(--radius-xs); font-size:.9rem;
  font-family:'DM Sans',sans-serif;
}
.opcao-admin-item input[type="text"]:focus { outline:none; border-color:var(--rosa); }

/* =====================
   EMPTY STATE
===================== */
.empty-state {
  text-align:center; padding:40px 20px; color:var(--cinza);
}
.empty-state .es-icon { font-size:2.8rem; margin-bottom:12px; }
.empty-state p { font-size:.9rem; line-height:1.6; }

/* =====================
   MODAL
===================== */
.modal-overlay {
  position:fixed; inset:0; background:rgba(26,16,24,.6);
  z-index:200; display:none; align-items:center; justify-content:center; padding:20px;
  backdrop-filter:blur(4px);
}
.modal-overlay.open { display:flex; }
.modal-box {
  background:var(--branco); border-radius:var(--radius);
  padding:32px; width:100%; max-width:480px; box-shadow:var(--sombra-lg);
  animation:modalIn .3s ease;
}
@keyframes modalIn { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.modal-title { font-size:1.4rem; color:var(--rosa-esc); margin-bottom:6px; }
.modal-sub { font-size:.85rem; color:var(--cinza); margin-bottom:20px; }

/* =====================
   FOOTER
===================== */
.site-footer {
  background:var(--escuro); color:rgba(255,255,255,.5);
  text-align:center; padding:32px 20px;
  font-size:.82rem; line-height:1.9;
}
.site-footer strong { color:rgba(255,255,255,.85); }
.site-footer a { color:var(--rosa); }

/* =====================
   RESPONSIVE
===================== */
@media(max-width:600px){
  .container { margin:20px auto; }
  .container-wide { padding:18px 14px; }
  .field-row { grid-template-columns:1fr; }
  .admin-tabs { border-radius:var(--radius); flex-direction:column; }
  .admin-tab { text-align:left; border-radius:var(--radius-sm); }
  .opcoes-grid { grid-template-columns:repeat(auto-fill,minmax(100px,1fr)); }
}
